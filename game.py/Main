import pygame

pygame.init()

font = pygame.font.SysFont("Arial", 36)
font.italic
font.bold
# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
WIN_WIDTH = 1540
WIN_HEIGHT = 1024
BLACK = (0,0,0)
FPS = 60
SPEED = 10
JUMP_SPEED = 18
GRAVITY = 0.8
MAX_FALL_SPEED = 20
BULLET_SPEED = 15
PUSHBACK = 5          # extra gap applied when resolving a wall collision
FRAME_WIDTH = 32
FRAME_HEIGHT = 32
idle_frames = []
run_frames = []

animation_speed = 0.15
#ENEMY_LEFT_BOUND = 260  # x position where the enemy turns around
#ENEMY_RIGHT_BOUND = 700



# ---------------------------------------------------------------------------
# Sprite classes
# ---------------------------------------------------------------------------
class GameSprite(pygame.sprite.Sprite):
    """Base sprite: loads an image, scales it, and positions its rect."""

    def __init__(self, image, x, y, width, height):
        super().__init__()
        self.image = pygame.transform.scale(pygame.image.load(image).convert_alpha(), (width, height))
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
        self.speed = 0

    def reset(self):
        """Draw this sprite at its current rect position (used for static sprites)."""
        window.blit(self.image, (self.rect.x, self.rect.y))
    

class Player(GameSprite):
    def __init__(self, image, x, y, width, height):
        super().__init__(image, x, y, width, height)
        self.x_speed = 0
        self.y_speed = 0
        self.frame = 0.0
        self.facing_right = True
        self.on_ground = False

    def update(self, events, walls):
        on_ground = False
        for event in events:
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_RIGHT:
                    self.x_speed = SPEED
                elif event.key == pygame.K_LEFT:
                    self.x_speed = -SPEED
                elif event.key == pygame.K_UP:
                    if self.on_ground:
                        self.y_speed = -JUMP_SPEED
                        self.on_ground = False
            elif event.type == pygame.KEYUP:
                if event.key == pygame.K_RIGHT and self.x_speed > 0:
                    self.x_speed = 0
                elif event.key == pygame.K_LEFT and self.x_speed < 0:
                    self.x_speed = 0

        self.y_speed = min(self.y_speed + GRAVITY, MAX_FALL_SPEED)

        if self.x_speed > 0:
            self.facing_right = True
        elif self.x_speed < 0:
            self.facing_right = False

        moving = self.x_speed != 0
        frames = run_frames if moving else idle_frames

        self.frame += animation_speed
        if self.frame >= len(frames):
            self.frame = 0

        image = frames[int(self.frame)]
        if not self.facing_right:
            image = pygame.transform.flip(image, True, False)

        self.rect.x += self.x_speed
        hits = pygame.sprite.spritecollide(self, walls, False)
        for wall in hits:
            if self.x_speed > 0:
                self.rect.right = wall.rect.left
            elif self.x_speed < 0:
                self.rect.left = wall.rect.right

        self.rect.y += self.y_speed
        hits = pygame.sprite.spritecollide(self, walls, False)
        for wall in hits:
            if self.y_speed > 0:
                self.rect.bottom = wall.rect.top
                self.y_speed = 0
                on_ground = True
            elif self.y_speed < 0:
                self.rect.top = wall.rect.bottom
                self.y_speed = 0

        self.on_ground = on_ground
        self.rect.clamp_ip(pygame.Rect(0, 0, WIN_WIDTH, WIN_HEIGHT))
        window.blit(image, self.rect)

class Enemy(GameSprite):
    """Patrols back and forth between ENEMY_LEFT_BOUND and the right edge of the window."""

    def __init__(self, image, x, y, width, height, speed,left,right):
        super().__init__(image, x, y, width, height)
        self.speed = speed
        self.left = left
        self.right = right


    def update(self):
        self.rect.x += self.speed
        if self.rect.right > self.right:
            self.speed *= -1
        elif self.rect.x < self.left:
            self.speed *= -1


class Bullet(GameSprite):
    def __init__(self, image, x, y, width, height):
        super().__init__(image, x, y, width, height)
        self.speed = BULLET_SPEED

    def update(self):
        self.rect.x += self.speed
        
        if self.rect.x > WIN_WIDTH + 10:  # off-screen -> remove
            self.kill()



#world building

window = pygame.display.set_mode((WIN_WIDTH, WIN_HEIGHT))
pygame.display.set_caption('The young adventurer')

idle_sheet = pygame.image.load(
    'idle.png'
).convert_alpha()
for i in range(11):      # change 11 if your Idle has a different number
    frame_image = idle_sheet.subsurface(
        (
            i * FRAME_WIDTH,
            0,
            FRAME_WIDTH,
            FRAME_HEIGHT
        )
    )

    idle_frames.append(frame_image)

scale = 3

for i in range(len(idle_frames)):
    idle_frames[i] = pygame.transform.scale(
        idle_frames[i],
        (FRAME_WIDTH * scale, FRAME_HEIGHT * scale)
    )

run_sheet = pygame.image.load(
    'run.png'
).convert_alpha()
for i in range(12):      
    frame_image = run_sheet.subsurface(
        (
            i * FRAME_WIDTH,
            0,
            FRAME_WIDTH,
            FRAME_HEIGHT
        )
    )

    frame = pygame.transform.scale(
        frame_image,
        (FRAME_WIDTH*3, FRAME_HEIGHT*3)
    )

    run_frames.append(frame)

#PLAYER///


#FIRST MENU
bg = GameSprite('MainMenu.png', 0, 0, WIN_WIDTH, WIN_HEIGHT)
play = GameSprite('play.png', 600, 400, 300, 100)
quit = GameSprite('quit.png', 600, 550, 300, 100)

#levels buttons
levels = pygame.sprite.Group()
level1 = GameSprite('level1.png',566, 330,390,100 )
level2 = GameSprite('level2.png',566, 470,390,100 )
level3 = GameSprite('level3.png',566, 610,390,100 )
levels.add(level1,level2,level3)

#Music///

mainSound = pygame.mixer_music.load('mainMusic.mp3')
pygame.mixer.music.play(-1)

coinSound = pygame.mixer.Sound('coin.mp3')


#levels backgrounds
lvl1map = GameSprite('lvl1Map.jpg', 0, 0, WIN_WIDTH, WIN_HEIGHT)
lvl2map = GameSprite('lvl2Map.png', 0, 0, WIN_WIDTH, WIN_HEIGHT)
lvl3map = GameSprite('lvl3Map.png', 0, 0, WIN_WIDTH, WIN_HEIGHT)

#IN-LEVELS GUI///
score = 0
COMPLETED_LEVEL1 = GameSprite("COMPLETED.png", 0, 0, WIN_WIDTH, WIN_HEIGHT)
menuButton = GameSprite('MENUBUTTON.png', 520, 690, 500,200 )
backButton = GameSprite('backButton.png',0,0,90,90)


#Level 1 walls
walls_level1 = pygame.sprite.Group()
platforms = pygame.sprite.Group()
boxes = pygame.sprite.Group()
platform = platforms.add(GameSprite('platform2.png', 500, 550, 200, 30 ))
platform2 = platforms.add(GameSprite('platform2.png', 520, 350, 150, 30 ))
platform3 = platforms.add(GameSprite('platform.png', 800, 250, 500, 50 ))
FloatingPlatform1 = platforms.add(GameSprite('floatingPlatform.png',  250, 450, 90, 30))
FloatingPlatform2 = platforms.add(GameSprite('floatingPlatform.png',  850, 450, 90, 30))
wall = platforms.add(GameSprite('miniplatform.png', 300, 700, 80, 30))
box = boxes.add(GameSprite('box .png', 700, 730, 100,100))
box2 = boxes.add(GameSprite('box .png', 1000, 730, 100,100))

ground = GameSprite('ground.png', 0, 830, WIN_WIDTH, 180)

walls_level1.add(
    platforms,
    boxes,
    ground
)

#level 2 obstacles and platforms
walls_level2 = pygame.sprite.Group()
platform = walls_level2.add(GameSprite('platform2.png', 550, 400, 200, 30 ))
platform2 = walls_level2.add(GameSprite('platform2.png', 300, 600, 200, 30 ))
ground2 = GameSprite('ground.png', 0, 830, WIN_WIDTH, 180)
walls_level2.add(ground2)

#level 3 obstacles and platforms
walls_level3 = pygame.sprite.Group()
platform = walls_level3.add(GameSprite('platform2.png', 650, 500, 220, 30 ))
platform2 = walls_level3.add(GameSprite('platform2.png', 300, 650, 220, 30 ))
ground3 = GameSprite('ground.png', 0, 830, WIN_WIDTH, 180)
walls_level3.add(ground3)

current_walls = walls_level1

#Level 1 targets
targets_level1 = pygame.sprite.Group()
coin = targets_level1.add(GameSprite('coin.png', 1030, 140, 80,80))
coin2 = targets_level1.add(GameSprite('coin.png', 1400,700, 80, 80))

#Level 2 targets
targets_level2 = pygame.sprite.Group()
coin = targets_level2.add(GameSprite('coin.png', 700, 300, 80,80))
coin2 = targets_level2.add(GameSprite('coin.png', 1400,700, 80, 80))

#Level 3 targets
targets_level3 = pygame.sprite.Group()
coin = targets_level3.add(GameSprite('coin.png', 800, 400, 80,80))
coin2 = targets_level3.add(GameSprite('coin.png', 1400,700, 80, 80))

current_targets = targets_level1

tree = GameSprite("tree.png",20, 530, 150, 300)


bullets = pygame.sprite.Group()
kunai = bullets.add(Bullet('kunai.png',0,0, 30,30))
player = Player('player1.png', 100, 700, FRAME_WIDTH * 3, FRAME_HEIGHT * 3)

clock = pygame.time.Clock()
run = True
screen = 'menu'
while run:
    
    events = pygame.event.get()
    for event in events:
        if event.type == pygame.QUIT:
            run = False
        
        if event.type == pygame.MOUSEBUTTONDOWN:
            
            if screen == "menu":
                if play.rect.collidepoint(event.pos):
                    screen = "levels"
                elif quit.rect.collidepoint(event.pos):
                    run = False
            elif level1.rect.collidepoint(event.pos):
                screen = "level1"
                current_walls = walls_level1
                current_targets = targets_level1
                player.rect.x, player.rect.y = 100, 700
                player.x_speed = 0
                player.y_speed = 0
                score = 0
            elif level2.rect.collidepoint(event.pos):
                screen = "level2"
                current_walls = walls_level2
                current_targets = targets_level2
                player.rect.x, player.rect.y = 100, 700
                player.x_speed = 0
                player.y_speed = 0
                score = 0
            elif level3.rect.collidepoint(event.pos):
                screen = "level3"
                current_walls = walls_level3
                current_targets = targets_level3
                player.rect.x, player.rect.y = 100, 700
                player.x_speed = 0
                player.y_speed = 0
                score = 0
            if backButton.rect.collidepoint(event.pos):
                screen = "menu"
            if screen == 'level_complete':
                if menuButton.rect.collidepoint(event.pos):
                    screen ="menu"
    if screen == "menu":
        bg.reset()
        play.reset()
        quit.reset()

    elif screen == "levels":
        bg.reset()
        levels.draw(window)

    elif screen == "level1":
        lvl1map.reset()
        backButton.reset()
        tree.reset()
        player.update(events, current_walls)
        reached = pygame.sprite.spritecollide(player, current_targets, True)
        if reached:
            coinSound.play()
            score += 1
            
        current_walls.draw(window)
        current_targets.draw(window)

    elif screen == "level2":
        lvl2map.reset()
        backButton.reset()
        player.update(events, current_walls)
        reached = pygame.sprite.spritecollide(player, current_targets, True)
        if reached:
            coinSound.play()
            score += 1
        current_walls.draw(window)
        current_targets.draw(window)

    elif screen == "level3":
        lvl3map.reset()
        backButton.reset()
        player.update(events, current_walls)
        reached = pygame.sprite.spritecollide(player, current_targets, True)
        if reached:
            coinSound.play()
            score += 1
        current_walls.draw(window)
        current_targets.draw(window)
    clock.tick(FPS)
    pygame.display.update()

pygame.quit()